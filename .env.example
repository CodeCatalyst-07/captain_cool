# ---------------------------------------------------------------------------
# captain-cool — environment variable template
#
# Copy this file to `.env` and fill in your real credentials.
# Never commit the populated `.env` file to version control.
# ---------------------------------------------------------------------------

# Google Gemini API key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CricketData.org API key
# Obtain from: https://cricketdata.org/pricing/
CRICKETDATA_API_KEY=your_cricketdata_org_key_here

# OpenWeatherMap API key
# Obtain from: https://home.openweathermap.org/users/sign_up
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here
